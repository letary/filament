// lecodes 0062: the ambient occlusion buffer multiplied onto the opaque half of a split color pass
// (View::setAmbientOcclusionAfterOpaque). One full-screen draw into the color target, the sky left
// alone (the SAO pass clears to 1 and skips the pixels at infinity).
material {
    name : aoComposite,
    parameters : [
        {
            type : sampler2dArray,
            name : ssao,
            precision: medium
        }
    ],
    variables : [
        vertex
    ],
    depthWrite : false,
    depthCulling : false,
    culling: none,
    blending : multiply,
    domain: postprocess
}

vertex {
    void postProcessVertex(inout PostProcessVertexInputs postProcess) {
        postProcess.vertex.xy = uvToRenderTargetUV(postProcess.normalizedUV);
    }
}

fragment {
    void postProcess(inout PostProcessInputs postProcess) {
        float ao = textureLod(materialParams_ssao, vec3(variable_vertex.xy, 0.0), 0.0).r;
        postProcess.color = vec4(ao, ao, ao, 1.0);
    }
}
